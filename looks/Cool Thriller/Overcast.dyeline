{
  "formatVersion": 1,
  "meta": {
    "name": "Overcast",
    "tags": [
      "cool",
      "grey",
      "flat"
    ],
    "author": "Dyeline contributors",
    "license": "CC-BY-4.0"
  },
  "chain": [
    {
      "tool": "three-way",
      "params": {
        "shadows-hue": 200,
        "shadows-amount": 0.2,
        "midtones-hue": 170,
        "midtones-amount": 0.1,
        "highlights-hue": 50,
        "highlights-amount": 0,
        "pivot": 0.18
      }
    },
    {
      "tool": "contrast",
      "params": {
        "contrast": 0.85
      }
    },
    {
      "tool": "hue-saturation",
      "params": {
        "saturation": 0.6
      }
    },
    {
      "tool": "highlight-shoulder",
      "params": {
        "start": 1.0,
        "headroom": 1.5
      }
    }
  ]
}
