        "midtones-amount": 0.4,
        "highlights-hue": 45,
        "highlights-amount": 0.45,
        "pivot": 0.18
      }
    },
    {
      "tool": "contrast",
      "params": {
        "contrast": 1.2
      }
    },
    {
      "tool": "hue-saturation",
      "params": {
        "saturation": 1.2
      }
    },
    {
      "tool": "diffusion",
      "params": {
        "amount": 0.2,
        "size": 1.0,
        "highlights": 0.6
      }
    },
    {
      "tool": "highlight-shoulder",
      "params": {
        "start": 1.0,
        "headroom": 1.5
      }
    }
  ]
